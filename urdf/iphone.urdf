<?xml version="1.0"?>
<robot name="iphone">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.14 0.07 0.008"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <link name="camera_link"/>
  <link name="camera_depth"/>
  <link name="imu_link"/>
  <link name="gps_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.035 0.0 0.004" rpy="0 0 0"/>
  </joint>

  <joint name="camera_depth_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_depth"/>
    <origin xyz="0.035 0.0 0.004" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.02 0.0 0.002" rpy="0 0 0"/>
  </joint>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0.0 -0.03 0.002" rpy="0 0 0"/>
  </joint>
</robot>
